# EasyDoc API environment template.
# Do not commit the real .env file.
#
# Demo-only seed credentials. The seeded demo accounts intentionally use a
# shared public password. Never reuse these credentials outside a disposable
# demo database.
# Required before seeding; the API fails to start if either password is
# missing or invalid. Minimum: 8+ chars, upper, lower, and digit.

DataSeed__UsersPassword=REPLACE_WITH_VALID_DEMO_PASSWORD_123!
DataSeed__AdminPassword=REPLACE_WITH_VALID_DEMO_PASSWORD_123!
DataSeed__AdminEmail=admin@example.com

# SQL Server connection string is supplied through user secrets or the
# deployment environment; see README.md.

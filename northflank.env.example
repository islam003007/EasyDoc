# EasyDoc API — Northflank environment template
# Copy this file to northflank.env (gitignored), fill in the values, and
# paste the keys into the EasyDoc API service environment in Northflank.
# Never commit real connection strings or passwords.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080

# Azure SQL Database free tier, configured with AutoPause
ConnectionStrings__DefaultConnection=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;Persist Security Info=False;User ID=<admin>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

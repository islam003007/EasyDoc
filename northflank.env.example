# EasyDoc API — Northflank environment template
# Copy this file to northflank.env (gitignored), fill in the values, and
# paste the keys into the EasyDoc API service environment in Northflank.
# Never commit real connection strings or passwords.

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_HTTP_PORTS=8080
ASPNETCORE_FORWARDEDHEADERS_ENABLED=true

# Azure SQL Database free tier, configured with AutoPause
ConnectionStrings__DefaultConnection=Server=tcp:<server>.database.windows.net,1433;Initial Catalog=<database>;Persist Security Info=False;User ID=<admin>;Password=<password>;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;

# Demo-only seed credentials. Never reuse in production.
# Required for fresh seeding. Minimum: 8+ chars, uppercase, lowercase, digit.
DataSeed__UsersPassword=REPLACE_WITH_VALID_DEMO_PASSWORD_123!
DataSeed__AdminPassword=REPLACE_WITH_VALID_DEMO_PASSWORD_123!
DataSeed__AdminEmail=admin@example.com

# Only enable this against a dedicated demo database. It wipes all rows and reseeds.
Demo__Reset__Enabled=true
Demo__Reset__IntervalHours=24

# Per-IP fixed-window limiter.
RateLimit__Enabled=true
RateLimit__PermitLimit=120
RateLimit__WindowSeconds=60

# Exact frontend origin allowed by CORS.
Frontend__AllowedOrigins__0=https://<easydoc-frontend-origin>
